APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bmty_staking
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Finex company wallets (public addresses are also defaulted in config/income.php)
DEPOSIT_WALLET=0x4d02Eda4EE50E55D97974D0C7b8647Ea9853B0aE
WITHDRAWAL_WALLET=0xE263603Cd83fa6c125D96B007933b70a667759e7
# Set ONLY on the server — never commit a real private key
WITHDRAWAL_PRIVATE_KEY=

# TEMP: test Daily ROI every 10 minutes (set TEST_ROI_ENABLED=false for production daily 00:05)
TEST_ROI_ENABLED=true
TEST_ROI_INTERVAL_MINUTES=10
TEST_ROI_DATE_SEED=2026-01-01

# ---- BSC on-chain Slot Activation (FinexVault) ----
# Use testnet for proper wallet testing (no real dollars)
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=testnet
BLOCKCHAIN_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# Your MockUSDT on BSC Testnet
BLOCKCHAIN_USDT_ADDRESS=0x65100813fEB38174Fd26457BbD13dc75D5E5D74c
BLOCKCHAIN_USDT_DECIMALS=18
# REQUIRED: your deployed FinexVault address on BSC Testnet
FINEX_VAULT_ADDRESS=
# Optional: full vault ABI JSON string (defaults to minimal invest ABI)
# FINEX_VAULT_ABI=
BLOCKCHAIN_TRUST_HASH=true
